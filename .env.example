# Seats.aero Pro API key (Partner-Authorization header)
# Get it from https://seats.aero -> account settings -> API
SEATS_AERO_API_KEY=

# Route
ORIGIN_AIRPORT=ORD
# Any of these may be used on either end (open-jaw combinations allowed, e.g. outbound into
# LIN, return from FCO)
ITALY_AIRPORTS=LIN,FCO,MXP

# Candidate dates. Each must be a contiguous range (start_date..end_date sent as one API call).
# Defaults assume the NEXT upcoming January relative to when you set this up (2027) since
# January 2026 has already passed. Adjust the year if that's wrong.
OUTBOUND_START_DATE=2027-01-05
OUTBOUND_END_DATE=2027-01-07
RETURN_START_DATE=2027-01-18
RETURN_END_DATE=2027-01-20

# Mileage programs to query (comma-delimited). flyingblue = Air France/KLM's own program;
# united = United MileagePlus; lufthansa = Lufthansa Miles & More (also covers Swiss/LX).
SOURCES=flyingblue,united,lufthansa

# Only accept itineraries flown entirely on these marketing carriers
CARRIERS=AF,KL,UA,LH,LX

# Trip requirements
PASSENGERS=2
CABIN=business
MAX_POINTS_PER_PASSENGER=90000
MAX_COPAY_USD_PER_PASSENGER=800
MAX_LAYOVER_MINUTES=180
# Max stops per itinerary (each connection must also be in Europe and within the layover limit)
MAX_STOPS=1

# Seats.aero self-imposed request budget (Pro accounts are capped at 1000/day by seats.aero
# itself, but the bot also enforces its own ceiling defensively)
MAX_REQUESTS_PER_DAY=1000

# Where daily request count + already-notified matches are persisted between runs
STATE_FILE=./state.json

# --- Email (Gmail SMTP) ---
# Use a Gmail App Password, not your normal password: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the Google account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=youraccount@gmail.com
SMTP_PASS=
EMAIL_FROM=youraccount@gmail.com
EMAIL_TO=youraccount@gmail.com
